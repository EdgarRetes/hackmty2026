[Unit]
Description=Gunicorn daemon for factorai backend
After=network.target

[Service]
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/factorai/backend
EnvironmentFile=/home/deploy/factorai/backend/.env
ExecStart=/home/deploy/factorai/backend/venv/bin/gunicorn \
    factorai_config.wsgi:application \
    --bind 127.0.0.1:8000
Restart=on-failure

[Install]
WantedBy=multi-user.target
